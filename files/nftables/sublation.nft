# ON DOCUMENTATION:
#
# There is an nftables wiki.  You can start:
# https://wiki.nftables.org/wiki-nftables/index.php/Configuring_chains.
#
# MOST IMPORTANTLY: "man nft" is the most thorough source, and should
# be visited right after the visuals from the wiki give a basic grasp.
#
# MOST INFORMATIVE SOURCES
#
# Starter:
# - https://wiki.archlinux.org/title/Nftables#Configuration
# - https://wiki.nftables.org/wiki-nftables/index.php/Quick_reference-nftables_in_10_minutes
#
# Topic-specific:
# - Chain hook types:
#   https://wiki.nftables.org/wiki-nftables/index.php/Configuring_chains#Base_chain_hooks
# - "Conntrack", iptables's and nftables's stateful connection
#   tracking:
#   https://wiki.nftables.org/wiki-nftables/index.php/Matching_connection_tracking_stateful_metainformation
#
# NOTES
#
# There are tables, families, and chains.  Tables belong to one
# family.  There can be multiple chains in each table.  The only
# chains that are mandatory - "base chains" - are ones that have a:
#   type ... hook ... priority
# Optional or "regular chains" can be jumped to if desired.  The order
# in which chains are run depends on their priority; lower priority
# chains run first.  Different tables belonging to the same family are
# effectively merged; the priority of chains determines the calling
# order.
#
# Sets can either be run-time or compile-time.  Run-time sets are
# those defined with set NAME { ... }, while compile-time sets are
# those defined by set NAME = ... .  To reference a run-time set use
# @; to reference a compile-time set use $.  The same applies
# generally to other, non-set variables.
#
# Note!: Named sets must be 16 characters or less
# (https://wiki.nftables.org/wiki-nftables/index.php/Sets)
#
# TIPS
#
# Use the following to check the syntax of a .nft file (-c) and suggest optimizations to it (-o):
#   sudo nft -c -o -f MY_CONFIG.nft
#
# OTHER USEFUL LINKS
#
# - https://wiki.nftables.org/wiki-nftables/index.php/Simple_rule_management
# - https://wiki.nftables.org/wiki-nftables/index.php/Sets
# - https://wiki.nftables.org/wiki-nftables/index.php/Building_rules_through_expressions
# - https://docs.redhat.com/en/documentation/red_hat_enterprise_linux/7/html/security_guide/sec-using_nftables_to_limit_the_amount_of_connections

define LAN_IF = "wlp108s0"
define LAN_SUBNET = 192.168.4.0/22
define WG_IF = "wg0"
define WG_SUBNET = 10.0.0.0/24
define NETBIRD_IF = "wt0"
define NETBIRD_SUBNET = 100.83.0.0/16
define TRUSTED_SRC = { 127.0.0.1, $LAN_SUBNET, $WG_SUBNET, $NETBIRD_SUBNET }

# Flush only my tables
table inet firewall {}          # No-op in case it doesn't exist yet
flush table inet firewall
table inet nat {}               # No-op in case it doesn't exist yet
flush table inet nat

# Table for disallowing and allowing IPv4 and IPv6 packets
table inet firewall {
    # Incoming packets addressed to and have now been routed to the
    # local system and processes running there
    chain incoming {
        type filter hook input priority filter; policy drop;

        jump sanity
        jump trust
        jump netbird
        # NOTE 2026-09-22: Superseded by Netbird, but still here,
        # merely commented out
        # jump wireguard
        jump public_services
        jump ssh
        jump icmp_control
        jump dns

        # Reject any rule that wasn't accepted above (as opposed to
        # "dropping" them, which would not signal anything to the
        # sender)
        counter reject with icmpx type port-unreachable
    }

    # Loopback handling + invalid-state drop
    chain sanity {
        ct state invalid counter drop # Drop invalid connections

        # Allow everything from loopback interface
        iif lo accept
        # Anti-spoof rules: drop packets destined to loopback address
        # but not coming from loopback interface
        iif != lo ip daddr 127.0.0.1/8 counter drop
        iif != lo ip6 daddr ::1/128 counter drop
        # Likewise, drop connections with a source address of loopback
        # but not originating there
        iif != lo ip saddr 127.0.0.0/8 counter drop
        iif != lo ip6 saddr ::1/128 counter drop
    }

    # Already-accepted traffic + LAN
    chain trust {
        # Allow packets from already "established" connections
        # (packets belonging to an already existing connection) and
        # "related" connections (new connections that are related to
        # connections we already know about)
        ct state vmap { established : accept, related : accept }

        # Accept anything originating from my LAN
        ip saddr $LAN_SUBNET accept
    }

    # Netbird server
    chain netbird {
        # STUN port must be publicly available.  (The Signal
        # functionality of Netbird lets two peers connect directly,
        # rather than indirectly, using of routing through the relay
        # server.)  NOTE: Only effective when the port itself is
        # publicly accessible, so this port should be forwarded from
        # my router
        udp dport 3478 accept
    }

    # Wireguard VPN
    chain wireguard {
        udp dport 53020 accept  # Initial connection
        iifname $WG_IF accept    # Accept all traffic in tunnel
    }

    # Caddy
    chain public_services {
        # Allow incoming web packets through web ports (necessary for
        # Caddy, since not accepting the web requests means Caddy
        # doesn't know to send data)
        tcp dport { 80, 443 } accept
        udp dport 443 accept
    }

    # SSH
    chain ssh {
        # Rate-limit (counter brute-force attempts)
        tcp dport ssh ct state new limit rate 10/minute accept
        # Reject clients that fail the rate-limit, keeping a counter
        tcp dport ssh ct state new counter reject with tcp reset
    }

    # Allow ICMP/ICMPv6: network control and diagnostic messages not
    # application traffic, but needed for basic network health (e.g.,
    # ping)
    chain icmp_control {
        ip protocol icmp accept
        ip6 nexthdr icmpv6 accept
    }

    # DNS
    chain dns {
        # Allow all standard (Tcp, Udp) DNS queries only from trusted
        # IPs
        ip saddr $TRUSTED_SRC tcp dport 53 accept
        ip saddr $TRUSTED_SRC udp dport 53 accept

        # Allow DNS-over-TLS (853/tcp) queries only from trusted IPs
        ip saddr $TRUSTED_SRC tcp dport 853 accept
    }

    # Incoming packets not addressed to the local machine
    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state invalid drop

        # New connections initiated BY a WireGuard peer (e.g. peer ->
        # server, or peer -> LAN device): accept (and let conntrack
        # start tracking them)
        iifname $WG_IF accept
        # Replies traveling back TOWARD a WireGuard peer (for the
        # established/related connections known and accepted from the
        # above rule)
        oifname $WG_IF ct state { established, related } accept

        # NOTE: Netbird handles its NAT routing with the rules it
        # inserts itself
    }

    # Packets originating from processes in the local machine
    chain outgoing {
        type filter hook output priority filter; policy accept;
    }
}

# Address translation for outbound Inet (IPv4, IPv6) connections
table inet nat {
    # Right after routing is complete, for packets leaving the system
    # (more specifically: only the first packet of a connection go
    # through the nat chain type; it's just that the nftables NAT
    # engine has the rest of the packets in the connection inherit
    # these mappings)
    chain postrouting {
        type nat hook postrouting priority srcnat;

        # Masquerade (rewrite source address) traffic for outbound
        # traffic that comes from the Wireguard interface and subnet
        # (forwarded from the "forward" chain above).  This means LAN
        # devices see those requests as originating from the server.
        # (Then later, incoming responses are un-rewritten
        # automatically by conntrack, restoring the original Wireguard
        # peer as the destination address)
        oifname $LAN_IF iifname $WG_IF ip saddr $WG_SUBNET masquerade

        # NOTE: Netbird handles its NAT routing with the rules it
        # inserts itself
    }
}
